# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NewsAPI Key (optional but recommended)
# Get a free key from: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# Reddit API OAuth Credentials (required for social media sentiment)
# Create a Reddit app at: https://www.reddit.com/prefs/apps
# 1. Go to https://www.reddit.com/prefs/apps
# 2. Click "create app" or "create another app" at the bottom
# 3. Select "script" as the app type
# 4. Fill in the name (e.g., "Sentiment Analysis Tool")
# 5. Redirect URI: http://localhost:8080 (not used but required)
# 6. Copy the client ID (under the app name) and secret
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=python:srsentiment:v1.0.0 (by /u/your_reddit_username)
